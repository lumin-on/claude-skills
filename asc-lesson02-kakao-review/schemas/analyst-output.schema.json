{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kakao-agenda-review/analyst-output",
  "title": "kakao-agenda-analyst 출력",
  "type": "object",
  "required": ["topics", "summary"],
  "additionalProperties": true,
  "properties": {
    "chunk": { "type": "string" },
    "range": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/topic" }
    }
  },
  "definitions": {
    "citation": {
      "type": "object",
      "required": ["line", "quote"],
      "additionalProperties": false,
      "properties": {
        "line": {
          "type": "string",
          "pattern": "^L[0-9]{3,6}$",
          "description": "L001 또는 L00001 형식의 줄 ID"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^L[0-9]{3,6} \\| ",
            "description": "줄 ID 접두어를 quote 에 넣으면 안 된다"
          }
        }
      }
    },
    "topic": {
      "type": "object",
      "required": [
        "id", "title", "status", "certainty", "conclusion",
        "evidence", "assumptions", "counter_evidence", "unknowns",
        "owner", "deadline", "next_check"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["해결·결정", "담당 지정", "진행 중", "흐지부지", "정보공유", null],
          "description": "agent 정의의 5개 값 또는 null. 새 상태값을 만들면 안 된다"
        },
        "certainty": { "enum": ["확정", "판단 보류"] },
        "conclusion": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/citation" },
          "description": "근거 없는 안건은 허용하지 않는다"
        },
        "counter_evidence": { "type": "array", "items": { "$ref": "#/definitions/citation" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "unknowns": { "type": "array", "items": { "type": "string" } },
        "owner": { "type": ["string", "null"] },
        "deadline": { "type": ["string", "null"] },
        "next_check": { "type": "string" }
      },
      "allOf": [
        {
          "description": "status 가 null 이면 certainty 는 반드시 판단 보류",
          "if": { "properties": { "status": { "type": "null" } } },
          "then": { "properties": { "certainty": { "const": "판단 보류" } } }
        }
      ]
    }
  }
}
