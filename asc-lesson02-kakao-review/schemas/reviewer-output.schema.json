{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kakao-agenda-review/reviewer-output",
  "title": "kakao-evidence-reviewer 출력",
  "type": "object",
  "required": ["reviews", "missing_topics", "overall"],
  "additionalProperties": true,
  "properties": {
    "chunk": { "type": "string" },
    "overall": { "type": "string", "minLength": 1 },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/review" }
    },
    "missing_topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "title": { "type": "string" },
          "note": { "type": "string" },
          "evidence": { "type": "array", "items": { "$ref": "#/definitions/citation" } }
        }
      }
    }
  },
  "definitions": {
    "citation": {
      "type": "object",
      "required": ["line", "quote"],
      "additionalProperties": false,
      "properties": {
        "line": { "type": "string", "pattern": "^L[0-9]{3,6}$" },
        "quote": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "^L[0-9]{3,6} \\| " }
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["topic_id", "verdict", "reason", "evidence", "assumptions", "counter_evidence", "unknowns"],
      "additionalProperties": true,
      "properties": {
        "topic_id": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["accept", "revise", "hold"] },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/citation" } },
        "counter_evidence": { "type": "array", "items": { "$ref": "#/definitions/citation" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "unknowns": { "type": "array", "items": { "type": "string" } },
        "proposed_change": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "description": "revise 또는 hold 이면 proposed_change 가 비어 있으면 안 된다 (agent 정의 규칙)",
          "if": { "properties": { "verdict": { "enum": ["revise", "hold"] } } },
          "then": {
            "properties": { "proposed_change": { "type": "string", "minLength": 1 } },
            "required": ["proposed_change"]
          }
        }
      ]
    }
  }
}
